# Install: see deploy/README.md. Replace @USER@ and @REPO_DIR@ before copying
# to /etc/systemd/system/.
[Unit]
Description=Update God's Eye View from the fork and recreate the container
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
User=@USER@
WorkingDirectory=@REPO_DIR@
# Invoke through bash so a checkout that lost the exec bit (e.g. committed from
# Windows) still runs.
ExecStart=/usr/bin/env bash @REPO_DIR@/deploy/update.sh
TimeoutStartSec=15min
